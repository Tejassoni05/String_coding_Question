// Fist non repeted char 
class Main {
    public static void main(String[] args) {
        String input = "AABBcDE";
        for (int i = 0 ; i< input.length(); i++){
            boolean unique = true ; 
            for(int j = 0 ; j<input.length();j++){
                if(i != j && input.charAt(i) == input.charAt(j)){  // i != j → same index nahi hona chahiye
                    unique = false;
                    break;
                }
            }
            if(unique){
                System.out.println(input.charAt(i));
                break;
            }
        }
        
    }
}
